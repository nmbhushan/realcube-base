# LOCAL DEVELOPMENT ONLY. Never commit a real .env file.
POSTGRES_USER=workspace
POSTGRES_PASSWORD=change-this-local-password
PLATFORM_DB_NAME=platform_db
PLATFORM_DATABASE_URL=postgresql://workspace:change-this-local-password@postgres:5432/platform_db
PLATFORM_API_PORT=3001
DATABASE_SSL=false

# Configure with the exact issuer, JWKS URL and audience from your OIDC provider.
OIDC_ISSUER_URL=https://YOUR_IDENTITY_PROVIDER/
OIDC_JWKS_URL=https://YOUR_IDENTITY_PROVIDER/.well-known/jwks.json
OIDC_AUDIENCE=enterprise-platform-api
OIDC_PERMISSIONS_CLAIM=permissions

# Enable only for the first-admin bootstrap ceremony; set a unique random 32+ character secret.
# Disable and remove the secret immediately after successful bootstrap.
PLATFORM_BOOTSTRAP_ENABLED=false
PLATFORM_BOOTSTRAP_SECRET=

# Outbox events remain durable in PostgreSQL when publishing is disabled.
# Enable on a worker deployment with a least-privilege SQS send policy.
OUTBOX_PUBLISHER_ENABLED=false
ACCESS_EVENTS_QUEUE_URL=
OUTBOX_POLL_INTERVAL_MS=5000
AWS_REGION=ap-south-1

NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:3001
