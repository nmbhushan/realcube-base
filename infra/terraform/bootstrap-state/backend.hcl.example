# Replace these values with terraform outputs and a globally unique bucket name.
bucket       = "realcube-workspace-tfstate-123456789012-ap-south-1"
key          = "bootstrap/terraform.tfstate"
region       = "ap-south-1"
encrypt      = true
kms_key_id   = "arn:aws:kms:ap-south-1:123456789012:key/REPLACE_WITH_STATE_KEY_UUID"
use_lockfile = true
