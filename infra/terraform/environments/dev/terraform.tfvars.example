project_name                  = "realcube-workspace-dev"
aws_region                    = "ap-south-1"
vpc_cidr                      = "10.40.0.0/16"
availability_zone_count       = 2
enable_nat_gateway            = true
single_nat_gateway            = true
tagged_image_retention_count  = 50
untagged_image_retention_days = 14

# EKS is explicitly disabled by default. Enable only after remote state,
# account permissions, private cluster connectivity and costs are reviewed.
enable_eks                       = false
eks_kubernetes_version           = "1.37"
eks_cluster_admin_principal_arn  = ""
eks_endpoint_public_access       = false
eks_endpoint_public_access_cidrs = []
eks_node_instance_types          = ["t3.large"]
eks_node_min_size                = 2
eks_node_desired_size            = 2
eks_node_max_size                = 4
# Set this to an existing SQS queue ARN to enable the outbox worker Pod Identity.
eks_access_events_queue_arn = ""

# VPC CNI identity rollout is deliberately staged:
# 1) enable identity and keep the node-role CNI policy attached;
# 2) validate it in staging;
# 3) only then set remove=true and approve=true in your local, untracked tfvars.
eks_enable_vpc_cni_pod_identity    = false
eks_remove_node_cni_policy         = false
eks_approve_vpc_cni_policy_cutover = false

# ALB Controller identity and WAF are separate opt-ins. The controller Helm chart
# is installed separately from an approved private operator network path.
eks_enable_load_balancer_controller = false
eks_enable_platform_waf_web_acl     = false
eks_waf_rate_limit                  = 2000
