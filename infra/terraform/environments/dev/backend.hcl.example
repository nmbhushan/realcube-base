# Use the bucket and KMS key ARN output by infra/terraform/bootstrap-state.
# Keep this as backend.hcl locally; do not commit the configured file.
bucket       = "realcube-workspace-tfstate-123456789012-ap-south-1"
key          = "realcube-workspace/dev/terraform.tfstate"
region       = "ap-south-1"
encrypt      = true
kms_key_id   = "arn:aws:kms:ap-south-1:123456789012:key/REPLACE_WITH_STATE_KEY_UUID"
use_lockfile = true
