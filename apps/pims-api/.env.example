# PIMS API
PORT=3002
PIMS_DATABASE_URL=postgresql://pims_app:change-me@localhost:5432/pims_db
PIMS_DATABASE_SSL=false
OIDC_ISSUER_URL=https://your-nonprod-issuer.example/
OIDC_JWKS_URL=https://your-nonprod-issuer.example/.well-known/jwks.json
PIMS_OIDC_AUDIENCE=pims-api
PIMS_MAX_TOKEN_AGE_SECONDS=300

# Platform access-change SQS consumer. Keep disabled until migration 002 is applied,
# the Platform producer includes oidcIssuer/oidcSubject in PIMS access events,
# and the queue/DLQ/least-privilege IAM role are configured.
PIMS_ACCESS_EVENTS_CONSUMER_ENABLED=false
PIMS_ACCESS_EVENTS_QUEUE_URL=
PIMS_ENTITLEMENT_MAX_AGE_SECONDS=60
AWS_REGION=ap-south-1
